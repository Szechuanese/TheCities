--- !u!114 &560180845
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 560180839}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f3f7b5b270cc23c408cfa31722c8fe63, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  traitToolTipPanel: {fileID: 1384682554}
  traitToolTipDescription: {fileID: 1448241757}
  traitToolTipHeader: {fileID: 961872224}
  numerical_value: {fileID: 239001185}
  progressBar: {fileID: 312515946}
  duration: 1
  entries:
  - id: Fang
    header: "\u96C4\u8FA9\u3001\u8BF4\u670D\u3001\u611F\u67D3"
    description: "\u5C16\u7259\u662F\u8BED\u8A00\u7684\u5229\u5668\uFF0C\u662F\u201C\u8BF4\u7406\u4E2D\u7684\u653B\u51FB\u6027\u201D\u3002\u636E\u6559\u4F1A\u4F20\u8BF4\uFF0C\u5E38\u8BD8\u9A91\u58EB\u66FE\u5728\u4E00\u6B21\u601D\u8FA8\u4E4B\u6218\u4E2D\uFF0C\u4EC5\u51ED\u4E03\u53E5\u8BDD\u8BA9\u6574\u5EA7\u5C0F\u6559\u5802\u7684\u4FE1\u5F92\u96C6\u4F53\u6539\u5949\u65B0\u7ECF\u6587\uFF0C\u8FDE\u4E3B\u8BB2\u8005\u90FD\u5728\u7B2C\u4E94\u53E5\u540E\u5F00\u59CB\u6A21\u4EFF\u4ED6\u7684\u53E3\u6C14\u3002"
  - id: Talon
    header: "\u5A01\u80C1\u3001\u65E0\u754F\u3001\u6B66\u529B"
    description: "\u5229\u722A\u662F\u201C\u66B4\u529B\u201D\u7684\u8C61\u5F81\uFF0C\u5B83\u4E0D\u662F\u529B\u91CF\u672C\u8EAB\uFF0C\u800C\u662F\u7528\u6765\u8BA9\u5BF9\u65B9\u660E\u767D\u2014\u2014\u7EE7\u7EED\u62B5\u6297\u5C06\u9020\u6210\u540E\u679C\u3002"
  - id: Pelt
    header: "\u9690\u85CF\u3001\u6DF7\u6DC6\u3001\u8BEF\u5BFC"
    description: "\u6BDB\u76AE\u662F\u4F2A\u88C5\u4E0E\u81EA\u4FDD\u7684\u5916\u58F3\u3002\u5B83\u901A\u5E38\u4E0D\u7528\u4E8E\u62B5\u6297\u653B\u51FB\uFF0C\u800C\u8BA9\u653B\u51FB\u627E\u4E0D\u5230\u76EE\u6807\u3002\u4F46\u5F53\u5B83\u5E94\u6FC0\u70B8\u8D77\uFF0C\u9020\u6210\u96BE\u4EE5\u60F3\u8C61\u7684\u7834\u574F\u529B\u3002"
  - id: Thigmata
    header: "\u6D1E\u5BDF\u3001\u8BB0\u5FC6\u3001\u6307\u8BA4"
    description: ">\u89E6\u80A2\u662F\u4EBA\u7C7B\u7684\u611F\u53D7\u5668\u5B98\uFF0C\u7528\u5B83\u6765\u5BDF\u89C9\u7EC6\u8282\u3001\u56DE\u5FC6\u5F80\u4E8B\u3001\u8FD8\u539F\u4E8B\u5B9E\uFF0C\u5728\u6A21\u7CCA\u7684\u53D9\u8FF0\u4E2D\u5206\u8FA8\u771F\u5047\u3002"
  - id: Wing
    header: "\u6D41\u52A8\u3001\u9003\u9038\u3001\u673A\u4F1A"
    description: "> \u7FC5\u8180\u4EE3\u8868\u7A7F\u8D8A\u4E0E\u9003\u9038\u7684\u80FD\u529B\u3002\u5F53\u5C40\u52BF\u4E0D\u53EF\u4E3A\u65F6\uFF0C\u7FC5\u8180\u7279\u8D28\u8005\u80FD\u627E\u5230\u4E0D\u88AB\u89C9\u5BDF\u7684\u79BB\u5F00\u8DEF\u5F84\uFF0C\u6216\u8005\u6293\u4F4F\u7A0D\u7EB5\u5373\u901D\u7684\u673A\u4F1A\u3002"
  - id: Tail
    header: "\u97E7\u6027\u3001\u5C3E\u968F\u3001\u575A\u6301"
    description: "\u5C3E\u5DF4\u4EE3\u8868\u4E00\u5207\u6B8B\u7559\u3001\u8DDF\u968F\u4E0E\u4E0D\u706D\u7684\u610F\u5FD7\u3002\u5373\u4F7F\u4E3B\u4F53\u53D7\u521B\uFF0C\u5C3E\u5DF4\u7279\u8D28\u8005\u4F9D\u7136\u80FD\u9760\u76F4\u89C9\u4E0E\u60EF\u6027\uFF0C\u5728\u6700\u540E\u5173\u5934\u9006\u8F6C\u5C40\u52BF\u3002"
  - id: Spore
    header: "\u5B55\u80B2\u3001\u540C\u5316\u3001\u6C61\u67D3"
    description: "\u5B62\u5B50\u4E0D\u662F\u751F\u547D\u672C\u8EAB\uFF0C\u800C\u662F\u751F\u547D\u7684\u788E\u7247\u4E0E\u9884\u8C0B\u3002\u5B83\u5728\u7A7A\u6C14\u4E2D\u6C89\u6D6E\u3001\u5728\u5E9F\u589F\u4E2D\u6E17\u900F\u3001\u5728\u4ED6\u4EBA\u610F\u8BC6\u91CC\u624E\u6839\u3002"
  - id: Rhizome
    header: "\u9690\u853D\u3001\u5206\u88C2\u3001\u8FDE\u7ED3"
    description: "\u6839\u987B\u662F\u5730\u4E0B\u8513\u5EF6\u7684\u77E5\u8BC6\u4E0E\u610F\u5FD7\uFF0C\u5B83\u4E0D\u663E\u4E8E\u8868\u9762\uFF0C\u5374\u80FD\u7A7F\u900F\u7ED3\u6784\u4E0E\u65F6\u95F4\u3002\u4E0D\u4E0E\u8868\u9762\u6743\u529B\u5BF9\u6297\uFF0C\u800C\u5728\u88C2\u7F1D\u4E2D\u7A7F\u884C\u3002\u4ED6\u4EEC\u64C5\u957F\u5EFA\u7ACB\u9690\u79D8\u901A\u9053\u3001\u601D\u60F3\u8054\u7CFB\uFF0C\u4E43\u81F3\u5728\u591A\u4E2A\u7EC4\u7EC7\u4E2D\u540C\u65F6\u201C\u5B58\u5728\u201D\u3002"
  - id: Rifle
    header: "\u8D77\u4E49\u3001\u5C0A\u4E25\u3001\u81EA\u7531"
    description: "> \u6B65\u67AA\u662F\u673A\u5668\u7684\u4EA7\u7269\uFF0C\u4EBA\u4EEC\u62FF\u8D77\u5B83\uFF0C\u7ED9\u5B83\u4E0A\u819B\uFF0C\u7528\u5B83\u7784\u51C6\uFF0C\u53CD\u6297\u4EFB\u4F55\u4E0D\u516C\u548C\u7F9E\u8FB1\u3002"
