    characterSequence: "!\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~\u2014\r\uFF0C\u3002\uFF01\uFF1F\uFF1B\uFF1A\u300C\u300D\u300E\u300F\uFF08\uFF09\u300A\u300B\u3008\u3009\u3010\u3011\u2014\u2026\u2026\xB7\uFFE5[]{}\n\\u200B\\u200C\\u200D\\u2060\\uFEFF\\u00A0\\u202F\r\u4E00\u4E03\u4E0A\u4E0B\u4E0D\u4E0E\u4E16\u4E24\u4E2A\u4E2D\u4E30\u4E3A\u4E3B\u4E3E\u4E48\u4E4B\u4E5D\u4E5F\u4E60\u4E86\u4E89\u4E8C\u4E8E\u4EB2\u4EBA\u4EC0\u4ECE\u4ED6\u4EE5\u4EEC\u4EF6\u4EFB\u4EFD\u4EFF\u4F19\u4F1A\u4F46\u4F4D\u4F4E\u4F55\u4F59\u4F5C\u4F60\u4F69\u4F7F\u4F8B\u4F8D\u4F9D\u4FDD\u4FE1\u4FEE\u505A\u5077\u50A8\u50CF\u513F\u5149\u5165\u516C\u517B\u5185\u518D\u5192\u5199\u51A0\u51AC\u51B3\u51E0\u51FA\u51FB\u5206\u5207\u5230\u524D\u5267\u529E\u52A8\u52CB\u52E4\u5305\u533B\u5348\u5361\u5370\u5374\u5385\u5386\u53BB\u53C8\u53D1\u53D7\u53E3\u53E6\u53EA\u53EB\u53EF\u53F0\u53F7\u53F8\u5408\u540D\u540E\u5411\u542C\u5439\u544A\u5458\u548C\u54C1\u54CD\u54E8\u5546\u5584\u55B7\u568F\u56DE\u56FE\u5728\u5730\u573A\u5750\u57CE\u57FA\u585E\u58EB\u58F0\u5907\u5916\u591A\u5927\u5929\u5931\u5934\u5939\u5949\u5973\u5979\u597D\u5982\u5988\u59CB\u59E8\u5A9A\u5B50\u5B57\u5B58\u5B64\u5B66\u5B83\u5B89\u5B8C\u5B9A\u5B9E\u5BA4\u5BB4\u5BB6\u5BCC\u5BF9\u5BFB\u5BFC\u5C0F\u5C11\u5C31\u5C40\u5C42\u5C4B\u5C5E\u5DE5\u5DF1\u5DF2\u5E08\u5E0C\u5E26\u5E2D\u5E74\u5E93\u5E95\u5E9E\u5E9F\u5EA6\u5EAD\u5F00\u5F0F\u5F20\u5F53\u5F62\u5F71\u5F80\u5F85\u5F88\u5F97\u5FAA\u5FC3\u5FC6\u600E\u603B\u604B\u6052\u60BB\u60C5\u60EF\u60F3\u610F\u6148\u6210\u6211\u6216\u6218\u6234\u623F\u6240\u624B\u6253\u6258\u627E\u628A\u6291\u629A\u62A5\u62CD\u62E6\u62EC\u62FC\u62FF\u6311\u6362\u636E\u638C\u63A2\u63A5\u63A8\u63CF\u63E1\u642C\u6492\u6536\u6559\u6570\u6574\u6587\u6591\u65B0\u65B9\u65C1\u65E0\u65E5\u65E7\u65F6\u660E\u6628\u662F\u665A\u6697\u66FE\u66FF\u6700\u6708\u6709\u671B\u672A\u673A\u6743\u6761\u6765\u676F\u6784\u6797\u679A\u679C\u67D0\u67DC\u67E5\u6807\u680B\u6811\u6821\u6837\u6839\u683C\u6848\u6863\u68A6\u68C0\u695A\u697C\u6A21\u6A2A\u6B21\u6B3E\u6B49\u6B63\u6B7B\u6BB5\u6BCD\u6BCF\u6BD4\u6C34\u6C38\u6C49\u6C89\u6CA1\u6CBB\u6CD5\u6CE1\u6CE8\u6D3B\u6D41\u6D6A\u6D77\u6DF7\u6E05\u6E10\u6E56\u6E90\u6EE1\u70B9\u70ED\u7136\u7167\u719F\u7236\u7247\u724C\u7252\u7269\u72B6\u72EC\u73B0\u7406\u74F6\u751A\u751F\u7528\u7537\u754C\u75C5\u75D5\u767B\u7684\u76D2\u76EE\u76F4\u76F8\u770B\u771F\u7740\u77E5\u793A\u793C\u795E\u79BB\u7A7A\u7A7F\u7A81\u7ACB\u7AD9\u7AE0\u7AE5\u7AEF\u7B11\u7B2C\u7B49\u7B54\u7B7E\u7BA1\u7BB1\u7C7B\u7CFB\u7D22\u7D2B\u7EB8\u7EBF\u7EC3\u7EC5\u7ECF\u7ED1\u7ED3\u7ED9\u7EDF\u7EF7\u7F16\u7F1D\u7FFB\u8001\u8033\u804C\u8054\u80A9\u80B2\u80CC\u80F8\u80FD\u8111\u811A\u8155\u8180\u81EA\u81F3\u820C\u822A\u8272\u827A\u8282\u8349\u8363\u83C7\u884C\u8857\u8863\u888B\u88AB\u89C1\u89C2\u89C9\u8A93\u8BA9\u8BB0\u8BBA\u8BC6\u8BCA\u8BD5\u8BD7\u8BDD\u8BEF\u8BF4\u8BF5\u8C0B\u8C0E\u8D22\u8D44\u8D70\u8D77\u8D8A\u8DD1\u8DEF\u8E69\u8EAB\u8F66\u8F68\u8F7B\u8FA9\u8FB9\u8FC7\u8FD0\u8FD8\u8FD9\u8FDB\u8FDC\u8FF0\u8FF7\u8FF9\u9001\u9003\u9009\u9010\u9012\u901A\u9053\u90A3\u90E8\u90FD\u9152\u9189\u9192\u91CC\u91D1\u9488\u949F\u9500\u9519\u957F\u95E8\u95F4\u9601\u961F\u9633\u9650\u9669\u96C6\u9759\u9760\u9762\u97F3\u98CE\u9A71\u9A97\u9AD8\u9E1F\u9ED1\u9F50\u9700\r\n\n
      \u554A\u95F9\u9B3C\u5462\u82E6\u77ED\u5FC5\u7EA0\u6597\u5C48\u5C45\u786E\u611F\u8C22\u8981\u644A\u4F84\u60DC\u826F\u7EE7\u7EED\u5438\u5F15\u6CE8\u65E9\u5E94\u8BE5\u5427\u4E00\u4E03\u4E0A\u4E0B\u4E0D\u4E0E\u4E16\u4E24\u4E2A\u4E2D\u4E3A\u4E3B\u4E3E\u4E48\u4E4B\u4E5D\u4E5F\u4E60\u4E86\u4E89\u4E8C\u4E8E\u4EB2\u4EBA\u4EC0\u4ECE\u4ED6\u4EE5\u4EEC\u4EF6\u4EFB\u4EFD\u4EFF\u4F19\u4F1A\u4F46\u4F4D\u4F4E\u4F55\u4F59\u4F5C\u4F60\u4F69\u4F7F\u4F8B\u4F9D\u4FDD\u4FE1\u4FEE\u505A\u5077\u50A8\u50CF\u513F\u5149\u5165\u516C\u517B\u5185\u518D\u5192\u5199\u51A0\u51AC\u51E0\u51FA\u51FB\u5206\u5230\u524D\u529E\u52A8\u52CB\u52E4\u5305\u533B\u5348\u5361\u5370\u5385\u5386\u53BB\u53D1\u53D7\u53E3\u53E6\u53EA\u53EB\u53EF\u53F0\u53F7\u53F8\u5408\u540D\u540E\u5411\u542C\u5439\u544A\u5458\u548C\u54C1\u54CD\u54E8\u5546\u5584\u55B7\u568F\u56DE\u56FE\u5728\u5730\u573A\u5750\u57CE\u57FA\u585E\u58EB\u58F0\u5907\u5916\u591A\u5927\u5929\u5931\u5934\u5939\u5973\u5979\u597D\u5982\u5988\u59CB\u59E8\u5A9A\u5B50\u5B57\u5B64\u5B66\u5B83\u5B89\u5B8C\u5B9A\u5B9E\u5BA4\u5BB4\u5BB6\u5BCC\u5BF9\u5BFB\u5BFC\u5C0F\u5C11\u5C31\u5C40\u5C4B\u5C5E\u5DE5\u5DF1\u5DF2\u5E08\u5E0C\u5E26\u5E2D\u5E74\u5E93\u5E95\u5E9F\u5EA6\u5EAD\u5F00\u5F0F\u5F20\u5F53\u5F62\u5F71\u5F80\u5F85\u5F88\u5F97\u5FC3\u5FC6\u600E\u603B\u604B\u6052\u60BB\u60EF\u60F3\u610F\u6148\u6210\u6211\u6218\u6234\u623F\u6240\u624B\u6253\u6258\u627E\u628A\u629A\u62CD\u62E6\u62EC\u62FC\u62FF\u6311\u6362\u636E\u638C\u63A5\u63A8\u63CF\u63E1\u642C\u6492\u6536\u6559\u6570\u6574\u6587\u6591\u65B0\u65B9\u65C1\u65E0\u65E5\u65E7\u65F6\u660E\u6628\u662F\u665A\u6697\u66FE\u66FF\u6700\u6708\u6709\u671B\u672A\u673A\u6743\u6761\u6765\u676F\u6784\u6797\u679A\u679C\u67D0\u67DC\u67E5\u6807\u680B\u6811\u6821\u6837\u6839\u683C\u6848\u6863\u68A6\u68C0\u695A\u697C\u6A21\u6B21\u6B3E\u6B49\u6B63\u6BB5\u6BCD\u6BCF\u6BD4\u6C34\u6C38\u6C49\u6C89\u6CA1\u6CBB\u6CD5\u6CE1\u6D3B\u6D41\u6D6A\u6D77\u6DF7\u6E05\u6E10\u6E56\u6EE1\u70B9\u70ED\u7136\u7167\u719F\u7236\u7247\u724C\u7252\u7269\u72B6\u72EC\u73B0\u7406\u74F6\u751A\u751F\u7528\u7537\u75C5\u75D5\u7684\u76D2\u76EE\u76F4\u76F8\u770B\u771F\u7740\u77E5\u793A\u793C\u79BB\u7A7A\u7A7F\u7A81\u7ACB\u7AD9\u7AE0\u7AE5\u7AEF\u7B11\u7B2C\u7B49\u7B54\u7B7E\u7BA1\u7BB1\u7C7B\u7CFB\u7D2B\u7EB8\u7EBF\u7EC3\u7EC5\u7ECF\u7ED1\u7ED3\u7ED9\u7EDF\u7EF7\u7F16\u7F1D\u7FFB\u8001\u8033\u804C\u8054\u80A9\u80B2\u80CC\u80F8\u80FD\u8111\u811A\u8155\u8180\u81EA\u81F3\u820C\u822A\u8272\u827A\u8282\u8349\u83C7\u884C\u8857\u8863\u888B\u88AB\u89C1\u8A93\u8BA9\u8BB0\u8BBA\u8BC6\u8BCA\u8BD5\u8BD7\u8BDD\u8BEF\u8BF4\u8BF5\u8C0B\u8C0E\u8D22\u8D70\u8D77\u8D8A\u8DD1\u8DEF\u8E69\u8EAB\u8F66\u8F68\u8F7B\u8FA9\u8FB9\u8FC7\u8FD0\u8FD8\u8FD9\u8FDB\u8FDC\u8FF0\u8FF7\u9001\u9003\u9009\u9010\u9012\u901A\u9053\u90A3\u90E8\u90FD\u9152\u9189\u9192\u91CC\u91D1\u9488\u949F\u9500\u9519\u957F\u95E8\u95F4\u9601\u961F\u9633\u9650\u9669\u9759\u9760\u9762\u97F3\u98CE\u9A71\u9A97\u9AD8\u9E1F\u9ED1\u9F50\u4E00\u4E0D\u4E2D\u4E48\u4EC0\u4F46\u4F60\u4FE1\u5185\u5305\u53D8\u53F7\u540E\u542B\u548C\u5728\u5B9E\u5BB9\u5C40\u5DF2\u5F00\u662F\u6848\u7565\u75C5\u7684\u76F8\u7701\u77E5\u7B54\u7ED3\u7F16\u80CC\u9053\u90A3\u91CF\u9645\r\n\u8611\u7CCA\u521D\u8C03\u4EE4\u5373\u5C06\u7279\u6B8A\u5173\u4E00\u4E03\u4E09\u4E0A\u4E0B\u4E0D\u4E0E\u4E13\u4E14\u4E16\u4E1A\u4E1C\u4E22\u4E24\u4E2A\u4E2D\u4E30\u4E3A\u4E3B\u4E3E\u4E48\u4E49\u4E4B\u4E5D\u4E5F\u4E60\u4E66\u4E86\u4E89\u4E8B\u4E8C\u4E8E\u4E91\u4E92\u4E98\u4E9B\u4EA1\u4EA4\u4EA6\u4EA7\u4EB2\u4EBA\u4EC0\u4EC5\u4EC7\u4ECA\u4ECB\u4ECD\u4ECE\u4ED6\u4ED7\u4ED8\u4EE3\u4EE4\u4EE5\u4EEA\u4EEC\u4EF0\u4EF6\u4EF7\u4EFB\u4EFD\u4EFF\u4F01\u4F0A\u4F17\u4F19\u4F1A\u4F20\u4F2A\u4F30\u4F34\u4F3C\u4F3D\u4F46\u4F4D\u4F4E\u4F4F\u4F53\u4F55\u4F59\u4F5A\u4F5C\u4F60\u4F69\u4F7F\u4F8B\u4F8D\u4F9D\u4FA3\u4FBF\u4FD1\u4FD7\u4FDD\u4FE1\u4FEE\u5012\u501F\u503C\u5047\u504F\u505A\u5077\u5080\u50A8\u50B2\u50CF\u50ED\u5121\u513F\u5145\u5148\u5149\u5165\u5168\u516B\u516C\u516D\u5171\u5173\u5175\u5176\u5177\u5178\u517B\u517C\u5185\u518D\u5192\u5199\u51A0